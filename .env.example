# Speech-to-text (default: "auto" -> Sarvam when SARVAM_API_KEY is set,
# else Groq Whisper when GROQ_API_KEY is set, else local faster-whisper)
SARVAM_API_KEY=

# Generation (Groq primary when set, Anthropic fallback)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional STT alternatives:
# ELEVENLABS_API_KEY=
